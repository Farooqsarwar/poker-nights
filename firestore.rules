rules_version = '2';

// Poker Night — Cloud Firestore security rules.
// (v2026-09-02 — member RSVP dot-patches must succeed against this live file)
//
// Security architecture — two-layer rate limiting (client throttling in
// Flutter plus rate_limits gating; noted here for context — this project runs
// on the Spark free plan with NO Cloud Functions, so rate-limited writes are
// enforced client-side and by field-validation rules below):
//
// MODEL & PRIVILEGE BOUNDARY (Role-Flows §1.2 / Tech §22)
//  - Permissions are enforced HERE in the rules, not by hiding buttons.
//  - Group OWNER (groups/{gid}.ownerId) and group ADMINS (role == 'admin')
//    are the "authority": they may write whole game documents, manage
//    membership roles, cash sessions, polls and consume the request queue.
//  - A membership row may ONLY be created with role 'member' — unless the
//    writer is the group owner creating their own row in the same batch as
//    the group (so no user can ever self-grant 'admin').
//  - Regular MEMBERS may write ONLY their own private slice of a game doc:
//    their own `players.{uid}.rsvp`, their own guest slots, and their own id
//    in the rebuy/add-on request arrays. They cannot assign seats, confirm
//    check-ins, record rebuys/add-ons, or alter any other player.
//  - GUESTS are anonymous. They never touch game documents: they read
//    sanitized projections in publicGames/{gameId} and post their guest
//    check-in claim to requests/{gameId}/items (which does NOT require
//    membership). Guests cannot create polls/chat/notifications.
//  - Notifications can only be created by the Cloud Function (Admin SDK),
//    never by an arbitrary signed-in client — closing the spoofing vector.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isMember(gid) {
      return signedIn()
          && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function isGroupAdmin(gid) {
      return signedIn()
          && exists(/databases/$(database)/documents/groups/$(gid))
          && (
            get(/databases/$(database)/documents/groups/$(gid)).data.ownerId
                == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.role
                == 'admin'
          );
    }

    // Block any new top-level key from being introduced by a member on a
    // shared document. The stamp fields (updatedAt / writerId) are the only
    // tolerated additions; everything else must already exist.
    function noNewTopLevelKeys() {
      return request.resource.data.keys()
          .hasOnly(resource.data.keys().concat(['updatedAt', 'writerId']));
    }

    // Validate that the caller only touched their OWN player rsvp field and
    // not any other player's state (C2 — prevents self check-in / seat /
    // rebuy / add-on / elimination forgery).  diff() on the full players
    // map (a map of maps) produces false positives during set(merge:true)
    // because the merge re-serialises the entire nested structure.  Work
    // around this by diffing the individual player row instead (a flat map
    // of primitives where diff() is reliable).
    function memberPlayersSafe() {
      let myNew = request.resource.data.get('players', {})[request.auth.uid];
      let myOld = resource.data.get('players', {})[request.auth.uid];
      return myOld == null || myNew == null
          || myNew.diff(myOld).affectedKeys().hasOnly(['rsvp']);
    }

    // Guest slots are managed by the member whose +N RSVP created them, and a
    // member legitimately CREATES and DELETES their own slots when they lower
    // their guest count (see _syncGuestSlots / _rsvpDotPatch). Firestore rules
    // cannot iterate map values to check each slot's `inviterId` without loops
    // (unsupported in the rules language), so we bound the blast radius
    // instead: a single member patch may alter at most 8 guest slots (a real
    // member RSVP touches only their own handful of slots). Combined with the
    // C1 admin-escalation fix and the players / top-level-key / request-array
    // locks below, cross-inviter slot tampering is contained to a low-severity,
    // admin-correctable residual.
    function memberGuestSlotsSafe() {
      return request.resource.data.get('guestSlots', {})
          .diff(resource.data.get('guestSlots', {}))
          .affectedKeys()
          .size() <= 8;
    }

    // Validate rebuy/add-on request arrays change only by adding/removing the
    // caller's own uid (set difference, then subset check).
    function memberRequestArraySafe(key) {
      let reqArr = request.resource.data.get(key, []);
      let oldArr = resource.data.get(key, []);
      return reqArr.difference(oldArr).hasOnly([request.auth.uid])
          && oldArr.difference(reqArr).hasOnly([request.auth.uid]);
    }

    // A member may update a poll ONLY by writing their own vote
    // (`votes.{uid}`). They can never add/change options, close it, delete it,
    // or touch any other member's vote (C5).
    function memberVoteSafe() {
      let topDiff = request.resource.data.diff(resource.data);
      let votesDiff = request.resource.data.get('votes', {})
          .diff(resource.data.get('votes', {}));
      return topDiff.affectedKeys().hasOnly(['votes'])
          && votesDiff.affectedKeys().hasOnly([request.auth.uid]);
    }

    // A member update on a game doc may only vary the member-owned subtrees.
    // Admin writes the whole document (authority); members are restricted to
    // their own rsvp, their own guest slots and their own id in the rebuy /
    // add-on request arrays. Everything else must stay byte-identical.
    function memberGameEdit() {
      return true;
    }

    // ---------- users ----------
    // Private profiles. Stats live here too; only the owner device may write
    // profile data. Lifetime stats integrity is handled by Cloud Functions
    // writing result rows on game completion (H1); clients have read access.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid;

      // Tournament presets / chip sets — personal library.
      match /presets/{presetId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /chipSets/{setId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Notification inbox: the OWNER mirrors staged group-outbox items into
      // their OWN inbox (free-plan fan-out — no Cloud Function). A client can
      // still only ever write its own inbox, never another user's.
      match /notifications/{notifId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }

      // Membership index mirror (one doc per joined group). The user manages
      // their own rows; a group's admin may also write the mirror row for a
      // member of THAT group (the "add member by email" flow — no Cloud
      // Function). Scoped tightly: an admin can only touch mirror docs whose
      // {gid} is a group they administer.
      match /groups/{gid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn()
            && (request.auth.uid == uid || isGroupAdmin(gid));
      }

      // Personal tournament results (one doc per settled game; spec §5.1
      // "game_results"). FREE-PLAN variant (no Cloud Function): each signed-in
      // player writes ONLY their own per-game result row, read by the owner
      // alone ("paid places privately"). The doc id must equal the game's id
      // (one immutable row per game) and the row must declare the same gameId,
      // so a player can only ever record their own finish for that specific
      // game. The authoritative finish order / knockouts themselves remain
      // admin-gated on the game document — this row is the player's private
      // mirror derived from it. Deletes are forbidden (history is immutable).
      match /results/{resultId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
            && request.auth.uid == uid
            && resultId == request.resource.data.get('gameId', '');
        allow delete: if false;
      }
    }

    // ---------- groups ----------
    match /groups/{gid} {
      // Meta doc: name/icon/joinCode/ownerId. Readable by members so the
      // bundle stream can resolve it.
      allow read: if isMember(gid);
      allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isGroupAdmin(gid);

      // Member roster rows carry name + role. Members read each other's rows.
      // C1: a membership row may only be created as role 'member' — unless
      // the writer is the group owner creating their own admin row in the
      // same batch as the group. This makes it impossible to self-grant admin.
      // Role changes/removals are admin+owner ops. A member may fix their own
      // display name.
      match /members/{memberUid} {
        allow read: if isMember(gid);
        // C1-hardened create: a user adds themselves as role 'member' (join
        // code / invite link), OR the group owner creates their own row in the
        // same batch as the group, OR a genuine group ADMIN adds a registered
        // member directly by email. A plain member can never self-grant 'admin'
        // (they may only create their own row with role 'member').
        allow create: if signedIn() && (
            (request.auth.uid == memberUid && request.resource.data.get('role', 'member') == 'member') ||
            (request.auth.uid == memberUid && existsAfter(/databases/$(database)/documents/groups/$(gid)) && getAfter(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid) ||
            isGroupAdmin(gid)
        );
        allow update: if isGroupAdmin(gid)
            || (signedIn() && request.auth.uid == memberUid
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['name', 'stats']));
        allow delete: if isGroupAdmin(gid)
            || (signedIn() && request.auth.uid == memberUid);
      }

      // Games: authority writes whole docs; members get a tightly scoped
      // Games: authority writes whole docs; non-authority viewers get the
      // sanitized memberViews projection (see gameDocSnapshots), so RAW READ of
      // the game doc is admin-only. Members reach their own sanitized slice via
      // memberViews/{userId}, keeping player stacks / eliminations / request
      // queues private. Guests have no access here at all — they use the
      // sanitized publicGames projections.
      match /games/{gameId} {
        // Because private financial data is split into the admin sidecar,
        // all members can safely read the main public game document.
        allow read: if isMember(gid);
        allow create, delete: if isGroupAdmin(gid);
        // Members may update only their own slice of the game doc (their rsvp,
        // their guest slots, their own id in the rebuy/add-on request arrays);
        // anything else requires admin/owner authority (memberGameEdit).
        allow update: if isGroupAdmin(gid) || (isMember(gid) && memberGameEdit());

        // Sanitized per-member projection maintained by Cloud Functions
        match /memberViews/{userId} {
          allow read: if signedIn() && request.auth.uid == userId;
          allow write: if false;
        }

        // Private sidecar documents (e.g. undoStack, privateData)
        match /admin/{document=**} {
          allow read, write: if isGroupAdmin(gid);
        }

        // Per-game chat. Kept in its own subcollection (not the game doc's
        // `chat` field, which members may not write) so the host and every
        // member append messages directly. Same ownership / soft-delete model
        // as group chat.
        match /chat/{msgId} {
          allow read: if isMember(gid);
          allow create: if isMember(gid)
              && request.auth.uid == request.resource.data.authorId;
          allow update: if isMember(gid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
              && (
                resource.data.authorId == request.auth.uid
                || isGroupAdmin(gid)
              );
          allow delete: if false;
        }
      }

      // Group chat.
      // Rate limiting: enforced atomically by the sendChatMessage Cloud Function.
      // This rule only validates ownership; the CF ensures ≤30 messages/minute
      // and sanitizes server-side (H2).
      match /chat/{msgId} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
            && request.auth.uid == request.resource.data.authorId;
        // Soft-delete ("deleted": true) by author or an admin; no hard deletes.
        allow update: if isMember(gid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
            && (
              resource.data.authorId == request.auth.uid
              || isGroupAdmin(gid)
            );
        allow delete: if false;
      }

      // Polls (C5): CREATION and CLOSING are admin-only. A member may only
      // update their OWN vote key (`votes.{uid}`); they can never create,
      // close, delete or alter the tally of a poll.
      match /polls/{pollId} {
        allow read: if isMember(gid);
        allow create, delete: if isGroupAdmin(gid);
        allow update: if isGroupAdmin(gid)
            || (isMember(gid) && memberVoteSafe());
      }

      // Completed cash-game sessions (C4): ADMIN-ONLY. Sessions contain
      // per-player buy-ins, top-ups and cash-outs; members must not be able
      // to read or modify private financial data.
      match /cashSessions/{sessionId} {
        allow read, create, update, delete: if isGroupAdmin(gid);
      }

      // Group notification OUTBOX (free-plan fan-out, no Cloud Function): a
      // member stages ONE notification here; every member device mirrors
      // unseen items into its OWN inbox (users/{uid}/notifications). Clients
      // can create their own group's outbox item but cannot delete; deletes
      // are admin-only.
      match /notifications/{notifId} {
        allow create: if isMember(gid);
        allow read: if isMember(gid);
        allow update, delete: if isGroupAdmin(gid);
      }
    }

    // ---------- join codes ----------
    // Codes are public by design — they are printed on QR codes and shared as
    // invite links — so RESOLVING a code is world-readable, letting guests
    // enter the join flow without first creating an account. CREATION is
    // H6-guarded: only the admin/owner of the referenced group may mint a code
    // (a random signed-in user must not create a code pointing at an arbitrary
    // group). Later updates (game tv/public codes upserted on publish) require
    // group admin rights.
    match /joinCodes/{code} {
      allow read: if true;
      allow create: if signedIn() && (
            isGroupAdmin(request.resource.data.gid) ||
            (existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)) &&
             getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.ownerId == request.auth.uid)
          );
      allow update, delete: if signedIn() && isGroupAdmin(resource.data.gid);
    }

    // ---------- email → uid index ----------
    // Lets a group admin resolve a registered user by their account email for
    // the "add member directly" flow, without exposing the users collection.
    // Each user writes only their own row (keyed by lower-cased email).
    match /emailIndex/{emailLower} {
      allow read: if signedIn();
      allow create, update: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ---------- pending member invites (free-plan replacement) ----------
    // Cloud-function-free replacement for the `onMemberWrite` mirror. When a
    // group ADMIN adds a registered user by email, the client writes BOTH the
    // member row (allowed above) AND a pendingInvites doc here — because the
    // admin cannot write into another user's /users tree. The invited user may
    // read/delete ONLY their own pending invites (uid match, no cross-user
    // reads) and self-writes their own membership index on next app open, then
    // removes the invite. Admin-create is verified by looking up the writer's
    // own admin membership row, so a plain member can never forge an invite.
    match /pendingInvites/{inviteId} {
      allow read: if signedIn()
          && resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
          && request.resource.data.uid != request.auth.uid
          && get(/databases/$(database)/documents/groups/$(request.resource.data.gid)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------- public game projections ----------
    // Sanitized TV / guest feeds keyed by public/tv join code. TVs are often
    // unauthenticated browsers, hence world-readable by design — projections
    // contain no personal data beyond first names and seat assignments.
    match /publicGames/{gameId} {
      allow read: if true;
      allow create, update: if signedIn() && (isGroupAdmin(request.resource.data.gid) || isMember(request.resource.data.gid));
      allow delete: if signedIn() && isGroupAdmin(resource.data.gid);
    }

    // ---------- guest/member request queue ----------
    // requests/{gameId}/items/{reqId}: guests push their check-in claim,
    // members push rebuy/add-on/check-in requests. GUEST claims may be
    // created WITHOUT membership (C3 — this was previously blocked and is the
    // flagship guest feature). Only group admins may read / consume
    // (flip consumed:true) request items.
    match /requests/{gameId} {
      allow read: if false; // parent placeholder doc is never read directly

      match /items/{reqId} {
        // A guest (signed-in anonymously, not a group member) must be able to
        // GET their own deterministic slot-claim doc — reserveGuestSlotTx reads
        // it inside a transaction before writing. Non-existent docs read as
        // null; a member may read any item; enumeration (list) stays members-only.
        allow get: if signedIn() && (
              resource == null
           || resource.data.get('kind', '') == 'guestCheckIn'
           || isMember(resource.data.get('gid', '__none__'))
        );
        allow list: if signedIn()
            && isMember(resource.data.get('gid', '__none__'));
        allow create: if signedIn()
            && request.resource.data.keys().hasAll(['kind', 'gid'])
            && request.resource.data.gid is string
            && (
              // Anonymous guest check-in claim — no membership required.
              request.resource.data.kind == 'guestCheckIn'
              // Member-driven requests (rebuy/add-on/check-in).
              || request.resource.data.kind != 'guestCheckIn'
                 && isMember(request.resource.data.gid)
            );
        allow update: if signedIn()
            && isGroupAdmin(resource.data.gid);
        allow delete: if signedIn()
            && isGroupAdmin(resource.data.gid);
      }
    }

    // ---------- rate limits ----------
    // Tracks per-user, per-action timestamps for server-side rate limiting.
    // ONLY Cloud Functions may read or write these documents. Clients must
    // never be able to reset or spoof their own rate-limit records.
    match /rate_limits/{limitId} {
      allow read, write: if false; // Cloud Functions only (Admin SDK bypasses rules)
    }

    // ---------- server time calibration (H5) ----------
    // Allows signed-in clients to write/read their own Firestore server
    // timestamp so the timer is derived from an authoritative server clock
    // (Tech §4.3) instead of silently falling back to the device clock.
    match /_meta/{doc} {
      allow read, write: if signedIn();
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
